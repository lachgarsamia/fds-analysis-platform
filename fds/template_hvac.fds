&HEAD CHID='###CHID###', TITLE='###TITLE### '  /

&MULT ID='m1', DX=0.25,DY=0.15,DZ=0.16,I_UPPER=3,J_UPPER=1,K_UPPER=2/
&MESH IJK=25,15,16, XB=0.0,0.25,-0.15,0.0,0.0,0.16, MULT_ID='m1' /

&DUMP DT_SLCF=0.25 /

&TIME T_END=###TIME### /

&REAC SOOT_YIELD=0.01,FUEL='METHANE'/
&SURF ID='BURNER', HRRPUA=48 /

&SURF ID="DEFAULT_COLOR", COLOR="INVISIBLE", DEFAULT=.TRUE. /


###CANDLE 1###
###CANDLE 2###

&VENT XB = 1.00,1.00,  0.06,0.12, 0.36,0.42, SURF_ID='OPEN', COLOR='BLUE' / Pressure release

&OBST XB = 0.26,1.00, -0.15,0.15, 0.22,0.24, COLOR='GRAY' / Ceiling
&OBST XB = 0.26,0.28, -0.15,0.15, 0.00,0.22, COLOR='GRAY' / Wall

###DOOR###

###VOC###

**********
!! HVAC !!
**********
&VENT XB= 0.32,0.40, -0.03,0.03,  0.22,0.22, COLOR='GREEN', ID='IN',SURF_ID='HVAC',IOR=-3/
&VENT XB= 0.32,0.40, -0.03,0.03,  0.24,0.24, COLOR='GREEN', ID='OUT',SURF_ID='HVAC',IOR=3/

&HVAC ID='INN',TYPE_ID='NODE',DUCT_ID='LEFT',VENT_ID='IN'/
&HVAC ID='OUTT',TYPE_ID='NODE',DUCT_ID='LEFT',VENT_ID='OUT'/

&HVAC ID='LEFT',TYPE_ID='DUCT',NODE_ID='INN','OUTT',LENGTH=0.2,AREA=0.04,FAN_ID='HVAC FAN',LOSS=0,0/
&HVAC ID='HVAC FAN',TYPE_ID='FAN',VOLUME_FLOW=0.016/


&SLCF PBY =  0.000, QUANTITY = 'TEMPERATURE' /
&SLCF PBY = -0.005, QUANTITY = 'TEMPERATURE', CELL_CENTERED = .TRUE. /

&SLCF PBY =  0.000, QUANTITY = 'VELOCITY' /
&SLCF PBY = -0.005, QUANTITY = 'VELOCITY', CELL_CENTERED = .TRUE. /

&TAIL /
