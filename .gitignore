# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# macOS
.DS_Store

# IDE
.vscode/

# Logs
*.log

# Test runner caches
.pytest_cache/
.coverage

# Data: simulation outputs are large (2.3G) and regenerable; test fixtures
# under tests/fixtures/ carry the data needed by the test suite.
fds/sim/

# Large media assets from the 2019 outreach event, ignored individually
# (not the whole banner/ directory -- a directory-level ignore also blocks
# git from ever re-including a file under it, even via a later `!` rule;
# see git's own gitignore(5) docs on that exact limitation). This keeps
# banner/img/'s small partner-logo assets (each under 100K) trackable,
# since branding.py actually loads them at runtime -- discovered while
# adding the Wuppertal logo that a blanket `banner/` rule meant even the
# pre-existing logo_fzj.svg had never been tracked, silently falling back
# to a plain-text label on any machine but ones that already had banner/
# locally from before it was gitignored.
banner/*.ai
banner/*.pdf
banner/img/front_image.jpg
banner/img/left_image.jpg
banner/img/right_image.jpg
image_video_sim/

# Runtime caches and ML outputs (see ROADMAP.md §8)
.cache/
predictions/

# M3.2 training artifacts (regenerable from ml/ scripts + ml/README.md,
# not source -- checkpoints are large binary blobs unsuited to git)
ml/checkpoints/
ml/runs/
*.pt
*.pth

# LaTeX build side-products
report/*.aux
report/*.out
report/*.toc
report/*.lof
report/*.lot
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
protocol/*.synctex.gz

# Session/tooling local state
.claude/

# Windows leftovers
Thumbs.db*
